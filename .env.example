# =============================================================================
# Configuration locale de Lanterne
#
# Copiez ce fichier en .env à la racine du dépôt, puis complétez les valeurs :
#   cp .env.example .env
# Le fichier .env est ignoré par git : ne commitez jamais de vraie valeur ici.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de données PostgreSQL (service « db » de compose.yaml)
#
# Vous n'avez pas besoin d'un compte PostgreSQL existant : l'utilisateur, le
# mot de passe et la base sont créés par le conteneur au premier démarrage.
# N'importe quelle valeur convient en local.
#
# Attention : ces trois variables ne sont lues qu'au premier démarrage, quand
# le volume de données est vide. Les modifier ensuite n'a aucun effet. Pour
# repartir de zéro, lancez « docker compose down -v », qui EFFACE les données.
# -----------------------------------------------------------------------------

# Nom de l'utilisateur créé dans PostgreSQL (exemple : lanterne)
POSTGRES_USER=

# Mot de passe de cet utilisateur. Obligatoire : sans lui, docker compose
# refuse de démarrer.
POSTGRES_PASSWORD=

# Nom de la base créée au démarrage (exemple : lanterne)
POSTGRES_DB=

# Port de PostgreSQL sur votre machine (pas dans le conteneur, où c'est
# toujours 5432). Laissez vide pour utiliser 5432 ; changez-le si un autre
# PostgreSQL utilise déjà ce port.
DB_PORT=

# -----------------------------------------------------------------------------
# Adminer : interface web d'administration de la base (http://localhost:8080)
#
# À la connexion, choisissez « PostgreSQL », le serveur « db » (pas
# « localhost ») et les identifiants ci-dessus.
# -----------------------------------------------------------------------------

# Port d'Adminer sur votre machine. Laissez vide pour utiliser 8080 ; changez-le
# si ce port est déjà pris.
ADMINER_PORT=

# -----------------------------------------------------------------------------
# Application web (apps/web)
#
# Les variables préfixées par VITE_ sont INTÉGRÉES au code envoyé au
# navigateur : n'y mettez jamais de secret (mot de passe, clé d'API privée).
#
# En développement, vous pouvez les laisser vides : l'application utilise
# alors les données simulées. En production, elles sont obligatoires.
# Voir docs/technique/architecture-web.md.
# -----------------------------------------------------------------------------

# Source des données : « mock » (données simulées, développement uniquement)
# ou « http » (API réelle). Laissez vide en développement pour « mock ».
VITE_API_MODE=

# Adresse de l'API, utilisée seulement avec VITE_API_MODE=http
# (exemple : http://localhost:3000/api/v1, valeur par défaut en développement).
VITE_API_BASE_URL=
